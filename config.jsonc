{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "auto",        // Logo type: auto, builtin, small, file, etc.
    "source": "fedora",      // Built-in logo name or file path
    "width": 35,           // Width in characters (for image logos)
    "height": 25,          // Height in characters (for image logos)
    "padding": {
        "top": 0,          // Top padding
        "left": 2,         // Left padding
        "right": 2         // Right padding
    },
    "color": {             // Override logo colors
        "1": "blue",
        "2": "red"
    }
  },
  "modules": [
    "title",
    "separator",
    "os",
    "packages",
    "terminal",
    "host",
    "uptime",
    "shell",
    "wm",
    "cpu",
    "gpu",
    "memory",
    "battery"
  ]
}
